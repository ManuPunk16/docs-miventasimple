---
import type { Props } from '@astrojs/starlight/props';
import DefaultThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
---

<div class="accessibility-controls flex items-center gap-3">
	<!-- Selector de tamaño de letra para accesibilidad -->
	<div class="font-size-selector flex items-center bg-[#0f1011] border border-[#23252a] rounded-md px-2 py-1 gap-1" title="Tamaño de texto">
		<button id="font-size-dec" class="text-xs text-[#8a8f98] hover:text-[#f7f8f8] px-1.5 py-0.5 rounded cursor-pointer transition-colors hover:bg-[#23252a] min-h-[32px] min-w-[32px] flex items-center justify-center font-bold" aria-label="Disminuir tamaño de letra">
			A-
		</button>
		<span id="font-size-label" class="text-xs text-[#d0d6e0] font-semibold px-1 min-w-[36px] text-center">100%</span>
		<button id="font-size-inc" class="text-xs text-[#8a8f98] hover:text-[#f7f8f8] px-1.5 py-0.5 rounded cursor-pointer transition-colors hover:bg-[#23252a] min-h-[32px] min-w-[32px] flex items-center justify-center font-bold" aria-label="Aumentar tamaño de letra">
			A+
		</button>
	</div>

	<!-- Renderizar el selector de tema por defecto de Starlight -->
	<div class="starlight-theme-wrapper">
		<DefaultThemeSelect {...Astro.props} />
	</div>
</div>

<script>
	// Gestión de estado local para el tamaño del texto
	const factorStep = 0.15;
	const minFactor = 0.85;
	const maxFactor = 1.45;
	
	let currentFactor = 1.0;

	// Cargar factor guardado en localStorage si existe
	const savedFactor = localStorage.getItem('vs-docs-font-scale');
	if (savedFactor) {
		const parsed = parseFloat(savedFactor);
		if (!isNaN(parsed) && parsed >= minFactor && parsed <= maxFactor) {
			currentFactor = parsed;
			applyFactor(currentFactor);
		}
	}

	function updateLabel(factor: number) {
		const labelEl = document.getElementById('font-size-label');
		if (labelEl) {
			labelEl.textContent = `${Math.round(factor * 100)}%`;
		}
	}

	function applyFactor(factor: number) {
		document.documentElement.style.setProperty('--text-scale-factor', factor.toString());
		updateLabel(factor);
		localStorage.setItem('vs-docs-font-scale', factor.toString());
	}

	document.getElementById('font-size-dec')?.addEventListener('click', () => {
		if (currentFactor > minFactor) {
			currentFactor = Math.max(minFactor, currentFactor - factorStep);
			applyFactor(currentFactor);
		}
	});

	document.getElementById('font-size-inc')?.addEventListener('click', () => {
		if (currentFactor < maxFactor) {
			currentFactor = Math.min(maxFactor, currentFactor + factorStep);
			applyFactor(currentFactor);
		}
	});

	// Inicializar etiqueta al cargar
	updateLabel(currentFactor);
</script>

<style>
	/* Asegurar que los botones tengan buen tamaño táctil */
	button {
		touch-action: manipulation;
	}
</style>
