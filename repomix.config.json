{
  "output": {
    "filePath": "repomix-output-docs-miventasimple.md",
    "style": "markdown",
    "removeComments": false,
    "showLineNumbers": false
  },
  "include": [
    "api/**",
    "angular/**",
    "public/**",
    "docs/**",
    "claude/**",
    "*.json",
    "*.js",
    "*.html",
    "*.css",
    "*.ts",
    "*.scss"
  ],
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/.angular/**"
    ]
  }
}