/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# GEO Audit — resultados locales (no subir al repo, se guardan como artefactos en CI)
/audits/

# Variables de entorno raíz (GEMINI_API_KEY y otros secrets locales)
.env
.env.local

# System files
.DS_Store
Thumbs.db

